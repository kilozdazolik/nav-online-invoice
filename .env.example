# Copy to .env (git-ignored) to run the integration spec:
#   bin/dev sh -c 'NAV_INTEGRATION=1 bundle exec rspec spec/integration'
# Never commit real values.

# test (default) or production; each needs its own technical user
NAV_ENVIRONMENT=test
NAV_LOGIN=
NAV_PASSWORD=
NAV_SIGNATURE_KEY=
# Only needed to submit; 16 characters
NAV_EXCHANGE_KEY=
# 8-digit tax number of the technical user's company
NAV_TAX_NUMBER=
# 18 characters of 0-9, A-Z and -, e.g. HU12345678ABCDE-01
NAV_SOFTWARE_ID=
NAV_SOFTWARE_DEV_NAME=
NAV_SOFTWARE_DEV_CONTACT=
# Tax number to look up
NAV_QUERY_TAX_NUMBER=
# Invoice and transaction queries read real invoices; in production they run only with this set to 1
NAV_ALLOW_PRODUCTION=
# Submits an invented invoice; only ever in the test environment
NAV_ALLOW_SUBMISSION=
# Also annuls it; the annulment then waits for approval on NAV's web interface
NAV_ALLOW_ANNULMENT=
